# ================= OCS AI 网关配置 =================
# 说明：这里的配置是「服务级」的；具体用哪个 AI、Key 是多少，全部在
#       http://127.0.0.1:8000/admin 网页里管理，不需要改这个文件。

# 服务监听地址与端口（默认只允许本机访问）
HOST=127.0.0.1
PORT=8000

# 可选：管理台访问口令。留空表示不校验（仅本机可访问时够用）
# 如果服务要暴露到局域网，强烈建议设置一个，管理页首次打开会要求输入。
GATEWAY_TOKEN=

# 可选：答案缓存有效期（小时），同一道题命中缓存直接秒答，不再调用 AI
# 设为 0 表示永久缓存
CACHE_TTL_HOURS=168

# 填空题单独的有效期（小时）。填空题没有选项可锚定，AI 单次作答更容易漂移，
# 默认只锁 24 小时，避免一条错答案被缓存一周。设为 0 则沿用 CACHE_TTL_HOURS。
# COMPLETION_CACHE_TTL_HOURS=24

# 可选：单次请求整体超时（秒），超过就换下一个 AI
REQUEST_TIMEOUT_SECONDS=30

# ---------- 选项快照（答题页上报选项真实内容） ----------
# 快照只放内存，默认保留 10 分钟；答案按选项指纹保存，默认 30 天
# OPTION_SNAPSHOT_TTL_SECONDS=600
# OPTION_SNAPSHOT_ANSWER_TTL_SECONDS=2592000
# 每个客户端每分钟最多上报次数；0 表示不限制
# SNAPSHOT_RATE_LIMIT=120

# ---------- 联网检索（可选，管理台「答题策略」里的开关默认关闭） ----------
# 默认用 360 搜索（无需 key，中文题库覆盖好），没结果时回退必应；
# 填入 Tavily key 后优先用 Tavily。
# TAVILY_API_KEY=
# WEB_SEARCH_ENGINE=auto        # auto / so / bing / tavily
# WEB_SEARCH_TIMEOUT=4

# 可选：跨源白名单。默认只放行学习通 / 中国大学MOOC / 学堂在线等课程站点和
# localhost（油猴脚本的 fetch 上报需要）；默认不再允许任意网页跨源访问。
# 需要额外站点时用逗号分隔填写，或覆盖 CORS_ORIGIN_REGEX；两项都留空 = 完全关闭跨源。
# CORS_ORIGINS=
# CORS_ORIGIN_REGEX=

# ---------- 首次运行自动导入（可选） ----------
# 如果 data/providers.json 还不存在，服务会用下面三项创建第一个 AI 条目，
# 方便你从旧版 knowledge-ext 直接迁移过来。留空则跳过。
OPEN_AI_BASE_URL=https://api.deepseek.com
OPEN_AI_API_KEY=
OPEN_AI_MODEL=deepseek-chat
